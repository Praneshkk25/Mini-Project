/backend/models/
/models/
!backend/app/models/
*.rar
*.zip
*.tar.gz
backend/data/streaming/
backend/app/models/heart_disease/train ecg images/


# --- Database Files ---
backend/hospital.db
*.db
*.sqlite
*.sqlite3

