# --- Sensitive Environment Variables & Keys (NEVER push secrets) ---
backend/.env
.env
.env.*
!.env.example
*-firebase-adminsdk-*.json
*firebase-admin*.json
*serviceAccountKey*.json
*.pem
*.key
credentials.json


