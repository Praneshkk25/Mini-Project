# CareEase AI - Environment Variables Template
# Copy this file to .env and fill in your actual keys

# LLM Provider: "gemini", "qwen", or "qwen-local-ft"
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Qwen 2.5 via Ollama (Required if LLM_PROVIDER=qwen)
QWEN_API_BASE=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL_NAME=qwen2.5:14b

# Fine-tuned Local Model (Required if LLM_PROVIDER=qwen-local-ft)
# Base model used for fine-tuning. Adapter saved in backend/models/qwen-triage-adapter/
LOCAL_FT_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Server Configuration
PORT=8000
HOST=127.0.0.1
