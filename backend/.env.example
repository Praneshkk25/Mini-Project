# CareEase AI - Environment Variables Template
# Copy this file to .env and fill in your actual keys

# LLM Provider: "gemini", "qwen", or "qwen-local-ft"
LLM_PROVIDER=gemini

# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Qwen 2.5 via Ollama (Required if LLM_PROVIDER=qwen)
QWEN_API_BASE=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL_NAME=qwen2.5:14b

# Fine-tuned Local Model (Required if LLM_PROVIDER=qwen-local-ft)
# Base model used for fine-tuning.
LOCAL_FT_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Hugging Face Model Hub Configuration (Private Model Repositories)
HF_TOKEN=your_hf_token_here
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_XGBOOST_REPO=PraneshKK/careease-xgboost-models
HF_QWEN_ADAPTER_REPO=PraneshKK/careease-qwen-triage-adapter
HF_MEDGEMMA_ADAPTER_REPO=PraneshKK/careease-medgemma-adapter
QWEN_ADAPTER_SOURCE=auto
XGBOOST_MODEL_SOURCE=auto

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Real-Time Patient Vital Monitoring & Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_VITALS_TOPIC=patient-vitals
KAFKA_ALERTS_TOPIC=patient-alerts
KAFKA_STATUS_TOPIC=patient-status
SPARK_MASTER=local[*]
STREAMING_MODE=simulation
MONITORING_INTERVAL_SECONDS=2
